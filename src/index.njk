<!DOCTYPE html>
<html lang="pt-PT" data-theme="reis">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script src="cookie-consent.js" defer></script>
  <title>Reis Barbearia | Corte e Barba nas Caldas da Rainha</title>
  <meta name="description" content="Reis Barbearia, nas Caldas da Rainha: corte de cabelo, degradê, taper fade e barba. Vê os nossos serviços, trabalho e avaliações. Marcar online é rápido." />
  <link rel="icon" href="assets/logo.png" />
  <link href="assets/fonts/fonts.css" rel="stylesheet" />

  <!-- daisyUI 5 + Tailwind CSS 4 (CDN, no build step) -->
  <link href="https://cdn.jsdelivr.net/npm/daisyui@5" rel="stylesheet" type="text/css" />
  <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

  <style type="text/tailwindcss">
    @theme {
      --color-gold: #fcc83d;
      --color-ink: #050505;
      --color-ink-2: #080808;
      --font-sans: 'Inter', system-ui, sans-serif;
      --font-display: 'IBM Plex Sans Condensed', sans-serif;
      --font-num: 'Oswald', sans-serif;
    }
    [data-theme="reis"] {
      color-scheme: dark;
      --color-base-100: #050505;
      --color-base-200: #080808;
      --color-base-300: #101010;
      --color-base-content: #ffffff;
      --color-primary: #fcc83d;
      --color-primary-content: #050505;
      --radius-field: 0;
      --radius-box: 0;
      --radius-selector: 0;
    }
    html { scroll-behavior: smooth; }
    body { -webkit-font-smoothing: antialiased; overflow-x: hidden; }
    ::selection { background: #fcc83d; color: #050505; }

    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .8s ease, transform .8s ease; }
    .reveal.in { opacity: 1; transform: none; }
    .hero-slide { opacity: 0; transform: scale(1.04); transition: opacity 1.2s ease, transform 4s ease-out; }
    .hero-slide.active { opacity: 1; transform: scale(1); }
    .nav-solid { background: #050505 !important; border-color: rgba(255,255,255,.08) !important; }
    .tab-btn { color: rgba(255,255,255,.45); border-color: transparent; cursor: pointer; }
    .tab-btn:hover { color: #fff; }
    .tab-btn[aria-selected="true"] { color: #fcc83d; border-color: #fcc83d; }
    /* Todos os painéis ocupam a mesma célula: a altura fica sempre igual à do painel maior */
    .tab-panels { display: grid; }
    .tab-panels > [role="tabpanel"] { grid-area: 1 / 1; align-content: start; }
    .tab-panels > [role="tabpanel"][hidden] { display: grid !important; visibility: hidden; }
    /* Contactos / localização */
    .location { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr)); background: #080808; border-top: 1px solid rgba(255,255,255,.06); color: #fff; font-family: 'Inter', system-ui, sans-serif; scroll-margin-top: 80px; }
    .location__map { position: relative; min-height: clamp(300px, 60vh, 500px); background: #050505; }
    /* Telemóvel/tablet: uma coluna, mapa no fim (depois dos contactos) */
    @media (max-width: 1023px) { .location { grid-template-columns: 1fr; } .location__map { order: 1; } }
    .location__map iframe { position: absolute; inset: 0; margin: auto; width: 75%; height: 75%; border: 0; }
    .location__map-load { position: absolute; inset: 0; width: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 12px; padding: 24px; background: transparent; border: 0; color: rgba(255,255,255,.7); font-size: 13px; text-align: center; cursor: pointer; }
    .location__map-btn { padding: 16px 32px; border: 1px solid #fcc83d; color: #fcc83d; font-size: 14px; font-weight: 700; letter-spacing: 2px; text-transform: uppercase; transition: background-color .2s, color .2s; }
    .location__map-load:hover .location__map-btn { background: #fcc83d; color: #050505; }
    .location__map-load:focus-visible { outline: 2px solid #fff; outline-offset: -4px; }
    .location__info { display: flex; flex-direction: column; justify-content: center; padding: clamp(56px, 9vh, 110px) clamp(20px, 5vw, 64px); }

    .location .eyebrow { margin: 0 0 18px; font-size: 12px; font-weight: 700; letter-spacing: 4px; text-transform: uppercase; color: #fcc83d; }

    .location .info { margin: 0; border-top: 1px solid rgba(255,255,255,.12); }
    .location .info > div { padding: 20px 0; border-bottom: 1px solid rgba(255,255,255,.12); }
    .location .info dt { margin: 0 0 8px; font-size: 12px; font-weight: 700; letter-spacing: 3px; text-transform: uppercase; color: #fcc83d; }
    .location .info dd { margin: 0; font-size: 17px; line-height: 1.6; color: rgba(255,255,255,.85); }
    .location .info dd a { color: #fff; text-decoration: none; }
    .location .info dd a:hover { color: #fcc83d; }
    .location .hours { display: flex; justify-content: space-between; gap: 16px; max-width: 300px; }
    .location .hours b { font-weight: 500; color: #fff; }
    .location .hours b.muted { color: rgba(255,255,255,.45); }

    .location .btn-row { display: flex; flex-wrap: wrap; gap: 12px; margin-top: clamp(28px, 4vh, 40px); }
    .loc-btn { display: inline-flex; align-items: center; padding: 18px 30px; font-size: 13px; font-weight: 800; letter-spacing: 2px; text-transform: uppercase; white-space: nowrap; text-decoration: none; border: 1px solid transparent; transition: .25s ease; }
    .loc-btn--primary { background: #fcc83d; color: #050505; }
    .loc-btn--primary:hover { background: #fff; }
    .loc-btn--outline { border-color: rgba(255,255,255,.3); color: #fff; }
    .loc-btn--outline:hover { border-color: #fcc83d; color: #fcc83d; }
    .loc-btn--gold-outline { border-color: rgba(252,200,61,.6); color: #fcc83d; }
    .loc-btn--gold-outline:hover { background: #fcc83d; color: #050505; }
  </style>
</head>

<body class="bg-ink text-white font-sans">

  <!-- NAVBAR -->
  <nav id="nav" class="navbar fixed top-0 inset-x-0 z-50 px-5 md:px-16 py-4 bg-transparent border-b border-transparent transition-colors duration-500">
    <div class="flex-1">
      <a href="#top" aria-label="Reis Barbearia"><img src="assets/logo.svg" alt="Reis Barbearia" class="h-13 w-auto" /></a>
    </div>
    <div class="hidden lg:flex items-center gap-10">
      <a href="#servicos" class="text-[13px] font-semibold tracking-[2px] uppercase hover:text-gold transition-colors">Serviços</a>
      <a href="#trabalho" class="text-[13px] font-semibold tracking-[2px] uppercase hover:text-gold transition-colors">Trabalho</a>
      <a href="#avaliacoes" class="text-[13px] font-semibold tracking-[2px] uppercase hover:text-gold transition-colors">Avaliações</a>
      <a href="#contactos" class="text-[13px] font-semibold tracking-[2px] uppercase hover:text-gold transition-colors">Contactos</a>
      <a href="{{ contact.bookingUrl }}" target="_blank" rel="noopener" class="btn btn-primary rounded-none border-0 h-auto px-7 py-4 text-[13px] font-extrabold tracking-[2px] uppercase whitespace-nowrap hover:bg-white">Marcar agora</a>
    </div>
    <button id="menuOpen" aria-label="Menu" class="lg:hidden btn btn-square btn-ghost rounded-none border border-white/25 flex-col gap-1.5">
      <span class="block w-5 h-0.5 bg-gold"></span>
      <span class="block w-5 h-0.5 bg-white"></span>
      <span class="block w-5 h-0.5 bg-white"></span>
    </button>
  </nav>

  <!-- MOBILE MENU -->
  <div id="menu" class="fixed inset-0 z-[60] bg-ink hidden flex-col px-6 py-5">
    <div class="flex items-center justify-between">
      <img src="assets/logo.svg" alt="Reis Barbearia" class="h-13 w-auto" />
      <button id="menuClose" aria-label="Fechar" class="btn btn-square btn-ghost rounded-none border border-white/25 text-xl">✕</button>
    </div>
    <div class="flex flex-col gap-1.5 mt-[8vh] font-display font-bold uppercase text-[44px] leading-[1.1]">
      <a href="#servicos" data-close>Serviços</a>
      <a href="#trabalho" data-close>Trabalho</a>
      <a href="#avaliacoes" data-close>Avaliações</a>
      <a href="#contactos" data-close>Contactos</a>
    </div>
    <a href="{{ contact.bookingUrl }}" target="_blank" rel="noopener" data-close class="btn btn-primary rounded-none border-0 mt-auto h-auto py-5 text-[15px] font-extrabold tracking-[2px] uppercase">Marcar agora</a>
  </div>

  <!-- HERO -->
  <header id="top" class="relative w-full min-h-svh flex overflow-hidden">
    <div class="absolute inset-0 bg-ink">
      <div class="hero-slide active absolute inset-0 bg-cover bg-center" style="background-image:url('assets/equipa.png')"></div>
      <div class="hero-slide absolute inset-0 bg-cover bg-[center_30%]" style="background-image:url('assets/galeria/corte-infantil-com-desenho.jpg')"></div>
      <div class="hero-slide absolute inset-0 bg-cover bg-center" style="background-image:url('assets/corte-risca.png')"></div>
      <div class="hero-slide absolute inset-0 bg-cover bg-center" style="background-image:url('assets/galeria/espelho-afro.jpg')"></div>
    </div>
    <div class="absolute inset-0 pointer-events-none bg-ink/35"></div>
    <div class="absolute inset-0 pointer-events-none" style="background:radial-gradient(80% 70% at 50% 50%, transparent 0%, rgba(5,5,5,.45) 100%)"></div>

    <div class="relative z-10 w-full flex flex-col items-center justify-center text-center px-5 md:px-16 pt-28 pb-20">
      <h1 class="m-0 leading-none">
        <img src="assets/logo.svg" alt="Reis Barbearia" class="w-[clamp(220px,32vw,420px)] h-auto drop-shadow-[0_6px_30px_rgba(0,0,0,.6)]" />
        <span class="sr-only">Barbearia de corte e barba nas Caldas da Rainha</span>
      </h1>
      <a href="{{ contact.bookingUrl }}" target="_blank" rel="noopener" class="btn btn-primary rounded-none border-0 mt-10 h-auto px-11 py-5 text-[15px] font-extrabold tracking-[2px] uppercase whitespace-nowrap hover:bg-white hover:-translate-y-0.5 transition">Marcar agora <span aria-hidden="true"></span></a>
    </div>
  </header>


    <!-- MENU DE SERVIÇOS -->
  <main id="servicos" class="scroll-mt-20 px-5 md:px-16 pt-24 md:pt-28 pb-[clamp(72px,11vh,140px)]">
        <h2 class="reveal font-display font-bold uppercase leading-[.95] text-[clamp(35px,8vw,65px)] mb-2 md:mb-6">Serviços<span class="sr-only"> para marcar online</span></h2>
    <!-- Separadores: cada botão mostra o painel com o mesmo id. Conteúdo em _data/services.json (editável no /admin) -->
    <div role="tablist" aria-label="Categorias de serviços" class="reveal flex gap-[clamp(20px,3vw,44px)] overflow-x-auto border-b border-white/10 mb-[clamp(16px,3vh,32px)] [scrollbar-width:none]">
      {%- for category in services.categories %}
      <button type="button" role="tab" id="tab-{{ category.id }}" aria-controls="{{ category.id }}" aria-selected="{{ 'true' if loop.first else 'false' }}" class="tab-btn shrink-0 -mb-px px-1 py-4 border-b-2 font-display font-bold uppercase text-[clamp(15px,1.5vw,19px)] tracking-[1px] whitespace-nowrap transition-colors">{{ category.label }}</button>
      {%- endfor %}
    </div>

    <div class="reveal tab-panels">
      {%- for category in services.categories %}
      <div role="tabpanel" id="{{ category.id }}" aria-labelledby="tab-{{ category.id }}" class="grid md:grid-cols-2 gap-x-[clamp(40px,6vw,96px)]"{% if not loop.first %} hidden{% endif %}>
        {%- for service in category.services %}
        <a href="{{ contact.bookingUrl }}{% if service.offerItemId %}/booking?offerItemId={{ service.offerItemId }}{% endif %}" target="_blank" rel="noopener" class="group grid grid-cols-[auto_minmax(16px,1fr)_auto] items-end gap-3 py-5 border-b border-white/10">
          <span><span class="block font-display font-semibold uppercase leading-tight text-[clamp(17px,1.6vw,21px)] transition-colors group-hover:text-gold">{{ service.name }}</span><span class="block mt-1 text-[11px] tracking-[2px] uppercase text-white/40">{{ service.duration }}</span></span>
          <span aria-hidden="true" class="mb-2 border-b border-dotted border-white/25"></span>
          <span class="font-num font-bold text-gold leading-none text-[clamp(20px,2vw,26px)]">€{{ service.price }}</span>
        </a>
        {%- endfor %}
      </div>
      {%- endfor %}
    </div>
  </main>

  <!-- CONHEÇA O MESTRE: conteúdo em _data/mestre.json (editável no /admin) -->
  <section id="mestre" class="scroll-mt-20 border-t border-white/5 px-5 md:px-16 py-[clamp(72px,11vh,140px)]">
    <div class="grid lg:grid-cols-2 gap-[clamp(48px,7vw,112px)] items-center">
      <div class="reveal relative pb-[18%] pr-[22%]">
        <img src="{{ mestre.mainPhoto.image }}" alt="{{ mestre.mainPhoto.alt }}" loading="lazy" class="w-full aspect-[4/5] object-cover" />
        <img src="{{ mestre.secondPhoto.image }}" alt="{{ mestre.secondPhoto.alt }}" loading="lazy" class="absolute right-0 bottom-0 w-[48%] aspect-[3/4] object-cover border-[6px] border-ink shadow-[0_20px_50px_rgba(0,0,0,.6)]" />
      </div>

      <div class="reveal order-first lg:order-none">
        <h2 class="font-display font-bold uppercase leading-[.95] text-[clamp(35px,8vw,65px)] mb-[clamp(24px,4vh,40px)]">O Mestre</h2>
        <p class="font-display font-semibold uppercase tracking-[2px] text-[clamp(18px,1.8vw,22px)] mb-5">{{ mestre.name }} <span class="text-white/40">  {{ mestre.role }}</span></p>
        <div class="space-y-4 text-[17px] leading-relaxed text-white/75 max-w-xl">
          {%- for paragraph in mestre.paragraphs %}
          <p>{{ paragraph.text }}</p>
          {%- endfor %}
        </div>
        <a href="{{ contact.bookingUrl }}" target="_blank" rel="noopener" class="btn btn-primary rounded-none border-0 h-auto mt-[clamp(28px,4vh,40px)] px-8 py-4.5 text-[13px] font-extrabold tracking-[2px] uppercase hover:bg-white">Marcar com o {{ mestre.name }} →</a>
      </div>
    </div>
  </section>

  <!-- TRABALHO -->
  <section id="trabalho" class="scroll-mt-20 border-t border-white/5 px-5 md:px-16 py-[clamp(72px,11vh,140px)]">
    <div class="reveal mb-[clamp(36px,5vh,60px)]">
      <h2><span class="sr-only">O nosso trabalho no Instagram: </span><a href="https://www.instagram.com/reis.barbearia23/" target="_blank" rel="noopener" class="inline-flex items-center gap-3.5 font-display font-bold leading-none text-[clamp(28px,4vw,52px)] hover:text-gold transition-colors"><span class="text-gold">@</span>reis.barbearia23 <span aria-hidden="true" class="text-gold text-[.7em]"></span></a></h2>    </div>

    <!-- Galeria (estilo slider): 3 fotos por slide no desktop, 1 no telemóvel. Conteúdo em _data/gallery.json (editável no /admin) -->
    <div class="reveal">
      <div class="relative">
        <div id="galeria" class="flex gap-3 overflow-x-auto snap-x snap-mandatory scroll-smooth [scrollbar-width:none] [&::-webkit-scrollbar]:hidden" role="region" aria-roledescription="carrossel" aria-label="Galeria de cortes">
        {%- for photo in gallery.photos %}
        <figure class="group relative overflow-hidden m-0 shrink-0 snap-start aspect-[3/4] w-full md:w-[calc((100%-24px)/3)]">
          <img src="{{ photo.image }}" alt="{{ photo.alt }}" loading="lazy" draggable="false" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
        </figure>
        {%- endfor %}
        </div>
        <button type="button" id="galPrev" aria-label="Slide anterior" class="absolute top-1/2 -translate-y-1/2 z-10 w-12 h-12 grid place-items-center bg-ink/70 border border-white/20 text-lg hover:border-gold hover:text-gold transition-colors cursor-pointer left-3 md:-left-6">←</button>
        <button type="button" id="galNext" aria-label="Slide seguinte" class="absolute top-1/2 -translate-y-1/2 z-10 w-12 h-12 grid place-items-center bg-ink/70 border border-white/20 text-lg hover:border-gold hover:text-gold transition-colors cursor-pointer right-3 md:-right-6"></button>
      </div>
      <div id="galDots" class="flex justify-center gap-2.5 mt-6"></div>
    </div>
  </section>

  <!-- AVALIAÇÕES -->
  <section id="avaliacoes" class="scroll-mt-20 bg-ink-2 border-t border-white/5 px-5 md:px-16 py-[clamp(72px,11vh,140px)]">
    <h2 class="reveal font-display font-bold uppercase leading-[.95] text-[clamp(35px,8vw,65px)] mb-[clamp(40px,6vh,64px)]"><span class="sr-only">Avaliações: </span>O QUE SE DIZ SOBRE NÓS</h2>
    <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-4">
      {%- for review in reviews.reviews %}
      <div class="card rounded-none bg-ink border border-white/10 p-[clamp(24px,3vw,36px)]">
        <div class="text-gold tracking-[3px] text-lg mb-4.5">{{ review.stars | stars }}</div>
        <p class="mb-6 leading-relaxed text-white/75">{{ review.text }}</p>
        <p class="text-[13px] tracking-[1px] uppercase text-gold">— {{ review.author }}</p>
      </div>
      {%- endfor %}
    </div>

    <a href="https://www.google.com/maps/search/?api=1&query=Reis+Barbearia+Rua+Fonte+do+Pinheiro+8+Caldas+da+Rainha" target="_blank" rel="noopener" class="btn btn-outline rounded-none mt-9 h-auto px-8 py-4.5 border-white/30 text-white text-[13px] font-bold tracking-[2px] uppercase hover:bg-transparent hover:border-gold hover:text-gold">Ver todas as avaliações <span aria-hidden="true"></span></a>
  </section>

  <!-- CONTACTOS -->
  <section class="location" id="contactos" aria-labelledby="loc-t">
    <div class="location__map">
      <!-- O mapa só é pedido à Google depois de o visitante clicar. -->
      <button type="button" class="location__map-load" data-map-src="https://maps.google.com/maps?q={{ (contact.street + ", " + contact.postalCity) | urlencode }}&z=16&output=embed">
        <span class="location__map-btn">Ver mapa</span>
        <span>O mapa é carregado a partir do Google Maps.</span>
      </button>
    </div>

    <div class="location__info">

      <h2 id="loc-t" class="font-display font-bold uppercase leading-[.95] text-[clamp(35px,8vw,65px)] mb-[clamp(40px,6vh,64px)]">Contactos</h2>
      <dl class="info">
        <div><dt>Localização</dt><dd><a href="https://www.google.com/maps/search/?api=1&query={{ ("Reis Barbearia " + contact.street + " " + contact.postalCity) | plus_query }}" target="_blank" rel="noopener">{{ contact.street }}<br>{{ contact.postalCity }}, {{ contact.country }}</a></dd></div>
        <div><dt>Horário</dt><dd>
          {%- for row in contact.hours %}
          <span class="hours"><span>{{ row.days }}</span><b{% if row.value == 'Encerrado' %} class="muted"{% endif %}>{{ row.value }}</b></span>
          {%- endfor %}
        </dd></div>
        <div><dt>Telefone</dt><dd><a href="https://wa.me/{{ contact.phone | digits }}" target="_blank" rel="noopener">{{ contact.phone }}</a></dd></div>

      </dl>

      <div class="btn-row">

        <a href="tel:+{{ contact.phone | digits }}" class="loc-btn loc-btn--outline">Ligar</a>
        <a href="{{ contact.bookingUrl }}" target="_blank" rel="noopener" data-close class="btn btn-primary rounded-none border-0 mt-auto h-auto py-5 text-[15px] font-extrabold tracking-[2px] uppercase">Marcar </a>
      </div>
    </div>
  </section>

  <!-- FOOTER -->
  <footer class="footer block bg-[#030303] border-t border-white/10 px-5 md:px-16 pt-[clamp(56px,8vh,96px)] pb-[calc(clamp(56px,8vh,96px)+80px)] lg:pb-[clamp(56px,8vh,96px)]">
    <div class="grid gap-[clamp(32px,5vw,64px)] grid-cols-1 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1.4fr_1fr]">
      <img src="assets/logo.svg" alt="Reis Barbearia" class="w-[clamp(140px,16vw,150px)] h-auto" />

      <nav aria-label="Rodapé">
        <p class="mb-4 text-xs font-bold tracking-[3px] uppercase text-gold">Navegação</p>
        <ul class="flex flex-col gap-2.5 text-[15px] text-white/70">
          <li><a href="#servicos" class="hover:text-gold transition-colors">Serviços</a></li>
          <li><a href="#trabalho" class="hover:text-gold transition-colors">Trabalho</a></li>
          <li><a href="#avaliacoes" class="hover:text-gold transition-colors">Avaliações</a></li>
          <li><a href="#contactos" class="hover:text-gold transition-colors">Localização &amp; Contactos</a></li>
        </ul>
      </nav>

      <div>
        <p class="mb-4 text-xs font-bold tracking-[3px] uppercase text-gold">Contacto</p>
        <ul class="flex flex-col gap-2.5 text-[15px] text-white/70">
          <li><a href="https://wa.me/{{ contact.phone | digits }}" target="_blank" rel="noopener" class="hover:text-gold transition-colors">{{ contact.phone }}</a></li>
          <li>{{ contact.street }}<br />{{ contact.postalCity }}</li>
        </ul>
        <a href="https://www.livroreclamacoes.pt/Inicio/" target="_blank" rel="noopener" class="inline-block mt-6 hover:opacity-70 transition-opacity">
          <img src="assets/livro-reclamacoes.png" alt="Livro de Reclamações" loading="lazy" width="1106" height="202" class="w-[100px] h-auto" />
        </a>
      </div>

      <div>
        <p class="mb-4 text-xs font-bold tracking-[3px] uppercase text-gold">Siga-nos</p>
        <ul class="flex flex-row gap-2.5 text-[15px] text-white/70">
          <li><a href="https://www.instagram.com/reis.barbearia23/" target="_blank" rel="noopener" aria-label="Instagram @reis.barbearia23" class="inline-flex w-11 h-11 items-center justify-center  hover:text-gold hover:border-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5.5 h-5.5" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"/></svg>
          </a></li>
          <li><a href="https://www.facebook.com/p/Alisson-Reis-Barber-Shop-61572821128853/" target="_blank" rel="noopener" aria-label="Facebook Alisson Reis Barber Shop" class="inline-flex w-11 h-11 items-center justify-center  hover:text-gold hover:border-gold transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" class="w-5.5 h-5.5" aria-hidden="true"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a></li>
        </ul>
      </div>
    </div>

    <!-- BARRA DE LOGOS -->
    <div class="flex! w-full justify-center mt-[clamp(32px,5vh,56px)] pt-[clamp(32px,5vh,56px)] border-t border-white/10">
      <img src="assets/BARRA_LOGOS-02.png" alt="PRR — Plano de Recuperação e Resiliência · República Portuguesa · Financiado pela União Europeia NextGenerationEU" loading="lazy" class="w-full max-w-[400px] h-auto" />
    </div>
    <div class="flex flex-wrap w-full items-center justify-between gap-5 mt-[clamp(32px,5vh,56px)] pt-7 border-t border-white/10">
      <div class="flex flex-wrap items-center gap-x-6 gap-y-2">
        <a href="politica-de-privacidade.html" class="text-xs text-white/60 hover:text-gold transition-colors">Política de Privacidade</a>
        <a href="politica-de-cookies.html" class="text-xs text-white/60 hover:text-gold transition-colors">Política de Cookies</a>
        <button type="button" data-cookie-settings class="text-xs text-white/60 hover:text-gold transition-colors cursor-pointer">Gerir cookies</button>
      </div>

      <span class="text-xs text-white/35">© 2026 Reis Barbearia. Todos os direitos reservados. Website por <a href="https://datahouse.studio" target="_blank" rel="noopener" class="text-white/60 hover:text-gold transition-colors">Datahouse Studio</a></span>
    </div>
  </footer>





  <script>
    // Navbar: transparente → preto ao fazer scroll
    const nav = document.getElementById('nav');
    const onScroll = () => nav.classList.toggle('nav-solid', window.scrollY > 40);
    addEventListener('scroll', onScroll, { passive: true }); onScroll();

    // Menu mobile
    const menu = document.getElementById('menu');
    const open = () => { menu.classList.remove('hidden'); menu.classList.add('flex'); };
    const close = () => { menu.classList.add('hidden'); menu.classList.remove('flex'); };
    document.getElementById('menuOpen').addEventListener('click', open);
    document.getElementById('menuClose').addEventListener('click', close);
    menu.querySelectorAll('[data-close]').forEach(a => a.addEventListener('click', close));

    // Slideshow do hero (3s por foto)
    const slides = document.querySelectorAll('.hero-slide');
    let i = 0;
    setInterval(() => {
      slides[i].classList.remove('active');
      i = (i + 1) % slides.length;
      slides[i].classList.add('active');
    }, 3000);

    // Separadores dos serviços
    const tabs = [...document.querySelectorAll('.tab-btn')];
    const selectTab = tab => tabs.forEach(t => {
      const on = t === tab;
      t.setAttribute('aria-selected', on);
      t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
    tabs.forEach((t, n) => {
      t.addEventListener('click', () => selectTab(t));
      t.addEventListener('keydown', e => {
        const step = { ArrowRight: 1, ArrowLeft: -1 }[e.key];
        if (!step) return;
        const next = tabs[(n + step + tabs.length) % tabs.length];
        selectTab(next); next.focus();
      });
    });
    selectTab(tabs.find(t => t.getAttribute('aria-selected') === 'true') || tabs[0]);

    // Galeria (slider): avança um slide inteiro de cada vez e volta ao início no fim
    const gal = document.getElementById('galeria');
    const galDots = document.getElementById('galDots');
    const galStep = () => gal.firstElementChild.offsetWidth + 12;
    const galPer = () => Math.max(1, Math.round((gal.clientWidth + 12) / galStep()));
    const galPages = () => Math.ceil(gal.children.length / galPer());
    const galPage = () => gal.scrollLeft + gal.clientWidth >= gal.scrollWidth - 4
      ? galPages() - 1 : Math.round(gal.scrollLeft / (galStep() * galPer()));
    const galGo = n => { const t = galPages(); gal.scrollTo({ left: ((n + t) % t) * galPer() * galStep() }); };
    const galDraw = () => {
      const t = galPages(), cur = galPage();
      if (galDots.children.length !== t) {
        galDots.innerHTML = '';
        for (let k = 0; k < t; k++) {
          const d = document.createElement('button');
          d.type = 'button'; d.setAttribute('aria-label', `Slide ${k + 1} de ${t}`);
          d.className = 'w-2.5 h-2.5 rounded-full transition-colors cursor-pointer';
          d.addEventListener('click', () => galGo(k));
          galDots.append(d);
        }
      }
      [...galDots.children].forEach((d, k) => {
        d.classList.toggle('bg-gold', k === cur); d.classList.toggle('bg-white/25', k !== cur);
        d.setAttribute('aria-current', k === cur);
      });
    };
    document.getElementById('galPrev').addEventListener('click', () => galGo(galPage() - 1));
    document.getElementById('galNext').addEventListener('click', () => galGo(galPage() + 1));
    gal.addEventListener('scroll', galDraw, { passive: true });
    addEventListener('resize', galDraw); galDraw();

    // Mapa: só carrega depois do clique
    const mapLoad = document.querySelector('[data-map-src]');
    mapLoad.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = mapLoad.dataset.mapSrc;
      frame.title = 'Mapa Reis Barbearia';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      mapLoad.replaceWith(frame);
      frame.focus();
    });

    // Animação fade-up
    const io = new IntersectionObserver(es => es.forEach(e => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach(el => io.observe(el));
  </script>
</body>
</html>
